<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VideoGameManager.Domain</RootNamespace>
    <AssemblyName>VideoGameManager.Domain</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- This project deliberately has no PackageReference and no ProjectReference.
       The dependency direction is one way: WinForms -> Services -> Data -> Domain.
       Entities and validation rules must stay usable without a database or a UI. -->

</Project>

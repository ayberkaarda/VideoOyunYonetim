<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the application logo to assets/app.ico and assets/logo-256.png.

       LogoPainter draws the logo with System.Drawing and is the single source of truth for
       its geometry; assets/logo.svg describes the same shapes as a vector for the README and
       for anything else that wants one. The tool never opens a window: it draws into
       off-screen bitmaps and writes files. See tools/LogoRenderer/README.md for how to run
       it. -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <!-- System.Drawing comes with the Windows Desktop runtime. Nothing here creates a
         window; the property only brings in the framework reference. -->
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>LogoRenderer</RootNamespace>
    <AssemblyName>LogoRenderer</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>

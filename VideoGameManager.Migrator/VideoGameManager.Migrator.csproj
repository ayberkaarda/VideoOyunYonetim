<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VideoGameManager.Migrator</RootNamespace>
    <AssemblyName>VideoGameManager.Migrator</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <!-- The scripts and the runner both live in the data layer, so this project is only a
         command line around them. It takes no other reference: a schema upgrade must not
         need the application, its configuration files or a desktop session. -->
    <ProjectReference Include="..\VideoGameManager.Data\VideoGameManager.Data.csproj" />
  </ItemGroup>

</Project>

## Visual Studio / .NET
## Trimmed from https://github.com/github/gitignore/blob/main/VisualStudio.gitignore

# Visual Studio user and cache files
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates
*.userprefs
*.rsuser

# Build output
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/
artifacts/
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Ww][Ii][Nn]32/
[Aa][Rr][Mm]/
[Aa][Rr][Mm]64/
bld/
[Oo]ut/
msbuild.log
msbuild.err
msbuild.wrn

# Test results and coverage reports
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*
coverage*.json
coverage*.xml
coverage*.info
*.coverage
*.coveragexml
TestResults/

# NuGet
*.nupkg
*.snupkg
**/[Pp]ackages/*
!**/[Pp]ackages/build/
project.lock.json
project.fragment.lock.json

# ReSharper / Rider
_ReSharper*/
*.[Rr]e[Ss]harper
.idea/

# Publish output
publish/
*.[Pp]ublish.xml
*.pubxml
*.pubxml.user
*.azurePubxml

# Application configuration - holds secrets, never committed
appsettings.Development.json
appsettings.Local.json
appsettings.*.local.json
secrets.json
*.env
.env
.env.*
!db/.env.example

# Database backups and dumps
*.bak
*.mdf
*.ldf
*.ndf
*.dacpac
*.bacpac

# Serilog / application logs
[Ll]ogs/*.txt
*.log

# Operating system
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

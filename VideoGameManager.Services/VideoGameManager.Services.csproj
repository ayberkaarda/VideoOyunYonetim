<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>VideoGameManager.Services</RootNamespace>
    <AssemblyName>VideoGameManager.Services</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- The nullable reference context is switched on one project at a time, in the
         direction the dependencies run. The entity project and the repository project
         below this one are already annotated, so the service contracts here are written
         against settled ones. The presentation, desktop and test projects still carry the
         shared setting that turns the context off, and compile without nullable
         diagnostics until their turn comes. -->
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoGameManager.Domain\VideoGameManager.Domain.csproj" />
    <ProjectReference Include="..\VideoGameManager.Data\VideoGameManager.Data.csproj" />
  </ItemGroup>

</Project>

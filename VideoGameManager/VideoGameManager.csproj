<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VideoGameManager</RootNamespace>
    <AssemblyName>VideoGameManager</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- .NET Framework 4.7.2 defaulted to DPI-unaware. The forms are fixed size
         and pixel aligned, so the same behaviour is kept here. -->
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
  </PropertyGroup>

  <!-- Assembly metadata, previously in Properties\AssemblyInfo.cs. -->
  <PropertyGroup>
    <Product>Video Game Manager</Product>
    <AssemblyTitle>Video Game Manager</AssemblyTitle>
    <Copyright>Copyright (c) 2025-2026 Ayberk Arda</Copyright>
    <Version>1.1.0</Version>
    <FileVersion>1.1.0.0</FileVersion>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Serilog is referenced by this project alone. Every other layer takes an
         ILogger<T> from the container and never sees the logging library, so the
         choice of sink stays a decision of the executable. -->
    <PackageReference Include="Serilog" Version="4.4.0" />
    <PackageReference Include="Serilog.Extensions.Logging" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dependency direction is one way and this project sits at the end of it:
         Presentation -> Services -> Data -> Domain. Nothing references back.

         No connection is opened and no SQL is written here - that stays behind the
         service interfaces. The forms do name types declared in Data (GameFilter,
         GameSortField, PagedResult, CatalogueStatistics), because the services return
         them; those arrive transitively and are read as values, never used to reach a
         database. -->
    <ProjectReference Include="..\VideoGameManager.Domain\VideoGameManager.Domain.csproj" />
    <ProjectReference Include="..\VideoGameManager.Services\VideoGameManager.Services.csproj" />
    <!-- Presenters and view interfaces live outside this project so they can be tested
         without a Windows target framework. The forms implement the interfaces. -->
    <ProjectReference Include="..\VideoGameManager.Presentation\VideoGameManager.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The cover cache keeps its scaling and cache-key helpers internal: they are
         implementation detail, not something another screen should call. The desktop
         test project still has to reach them to prove that artwork keeps its
         proportions and that a cache entry is tied to the size it was stored at. -->
    <InternalsVisibleTo Include="VideoGameManager.Tests.Desktop" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Git-ignored, holds the real password, overrides appsettings.json when present. -->
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Properties\Resources.resx has no matching Resources.cs, so it falls
         outside the DependentUpon convention and is declared explicitly. The
         manifest name must stay VideoGameManager.Properties.Resources. -->
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>

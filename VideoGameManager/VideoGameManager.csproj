<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VideoGameManager</RootNamespace>
    <AssemblyName>VideoGameManager</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- .NET Framework 4.7.2 defaulted to DPI-unaware. The forms are fixed size
         and pixel aligned, so the same behaviour is kept here. -->
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Assembly metadata, previously in Properties\AssemblyInfo.cs. -->
  <PropertyGroup>
    <Product>Video Game Manager</Product>
    <AssemblyTitle>Video Game Manager</AssemblyTitle>
    <Copyright>Copyright (c) 2025-2026 Ayberk Arda</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Data.SqlClient is absent from the .NET 10 BCL and no longer
         maintained. Microsoft.Data.SqlClient is the supported provider. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Properties\Resources.resx has no matching Resources.cs, so it falls
         outside the DependentUpon convention and is declared explicitly. The
         manifest name must stay VideoGameManager.Properties.Resources. -->
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VideoGameManager</RootNamespace>
    <AssemblyName>VideoGameManager</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- .NET Framework 4.7.2 defaulted to DPI-unaware. The forms are fixed size
         and pixel aligned, so the same behaviour is kept here. -->
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Assembly metadata, previously in Properties\AssemblyInfo.cs. -->
  <PropertyGroup>
    <Product>Video Game Manager</Product>
    <AssemblyTitle>Video Game Manager</AssemblyTitle>
    <Copyright>Copyright (c) 2025-2026 Ayberk Arda</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The dependency direction is one way: WinForms sees Services and Domain, never
         Data. Data access reaches this project only through the service interfaces. -->
    <ProjectReference Include="..\VideoGameManager.Domain\VideoGameManager.Domain.csproj" />
    <ProjectReference Include="..\VideoGameManager.Services\VideoGameManager.Services.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <!-- Git-ignored, holds the real password, overrides appsettings.json when present. -->
    <None Update="appsettings.Development.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <!-- Properties\Resources.resx has no matching Resources.cs, so it falls
         outside the DependentUpon convention and is declared explicitly. The
         manifest name must stay VideoGameManager.Properties.Resources. -->
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>

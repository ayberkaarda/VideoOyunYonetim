<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VideoOyunY</RootNamespace>
    <AssemblyName>VideoOyunY</AssemblyName>
    <ApplicationIcon>icon.ico</ApplicationIcon>
    <!-- .NET Framework 4.7.2 varsayılanı DPI-unaware idi; formlar sabit boyutlu ve
         piksel hizalı olduğu için aynı davranış korunuyor. -->
    <ApplicationHighDpiMode>DpiUnaware</ApplicationHighDpiMode>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
  </PropertyGroup>

  <!-- Eski Properties\AssemblyInfo.cs yerine derleme meta verisi burada. -->
  <PropertyGroup>
    <Product>VideoOyunY</Product>
    <AssemblyTitle>VideoOyunY</AssemblyTitle>
    <Copyright>Copyright © 2025-2026 Ayberk Arda</Copyright>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- System.Data.SqlClient .NET 10 BCL'inde yok ve artık bakım almıyor.
         Microsoft.Data.SqlClient güncel, desteklenen sağlayıcıdır. -->
    <PackageReference Include="Microsoft.Data.SqlClient" Version="6.1.1" />
  </ItemGroup>

  <ItemGroup>
    <!-- Properties\Resources.resx, Resources.cs adında bir dosyaya bağlı olmadığı için
         DependentUpon kuralı dışında bırakılıp açıkça tanımlanıyor. -->
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>True</AutoGen>
      <DesignTime>True</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

</Project>

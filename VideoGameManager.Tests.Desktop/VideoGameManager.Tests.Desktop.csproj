<Project Sdk="Microsoft.NET.Sdk">

  <!-- The desktop half of the test suite. VideoGameManager.Tests targets `net10.0` so it
       runs on any operating system, which is also why it cannot reference the desktop
       project: a `net10.0` project may not reference a `net10.0-windows` one. Anything
       that has to exercise code sitting behind Windows Forms or GDI+ therefore lives
       here instead, and this project builds and runs on Windows only. -->

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>VideoGameManager.Tests.Desktop</RootNamespace>
    <AssemblyName>VideoGameManager.Tests.Desktop</AssemblyName>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!-- Tests are not a public API, so the missing-XML-comment warning that the other
         projects treat as useful noise here would only be noise. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.9.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Pinned to the 7.x line for the same licensing reason as the other test project. -->
    <PackageReference Include="FluentAssertions" Version="7.2.0" />
    <PackageReference Include="coverlet.collector" Version="6.0.4">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- NullLogger, so a type under test gets a logger without a logging framework. -->
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VideoGameManager\VideoGameManager.csproj" />
  </ItemGroup>

</Project>
